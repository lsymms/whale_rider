# Whale Rider local configuration template. Commit this placeholder only; .env is ignored.
# Fill values on this host only. Leave optional values blank until their milestone.

# Service and storage
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8787
APP_RUNTIME_DIR=
APP_SESSION_SECRET=

# Webull OpenAPI â€” required for the M0 read-only capability probe.
WEBULL_ENV=production
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCESS_TOKEN=
WEBULL_ACCOUNT_ID=

# Telegram â€” required when the notification milestone begins.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=

# AI â€” required for screenshot OCR and trade-suggestion explanations.
# Set AI_PROVIDER to openai only when OPENAI_API_KEY is configured.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_BASE_URL=

# Safety defaults: the MVP remains read-only with manual Webull execution.
WEBULL_ORDER_ACTIONS_ENABLED=false
TELEGRAM_LIVE_DELIVERY_ENABLED=false
AI_CLOUD_IMAGE_PROCESSING_ENABLED=false